# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais committer .env.

# Obligatoire : clé Groq (https://console.groq.com)
GROQ_API_KEY=

# Recommandé en production : clé partagée exigée dans l'en-tête X-API-Key.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optionnel
GROQ_MODEL=openai/gpt-oss-20b
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LOG_LEVEL=INFO
